# =============================================================================
# rag-glassbox — environment configuration
#
# NOTHING here is committed with real values. Copy to `.env.local` for local dev
# (gitignored), and set the production values in the Vercel dashboard. Never put a
# secret behind a NEXT_PUBLIC_ prefix — those are inlined into the browser bundle.
# =============================================================================

# --- Show the "Generate answer" step (frontend flag) ---------------------------
# Build-time flag, inlined into the client bundle. Not a secret — just toggles the
# UI. With it off (unset), the hosted demo is retrieval-only. Requires a working
# generation provider below to actually produce answers.
# NEXT_PUBLIC_ENABLE_GENERATION=true

# =============================================================================
# GENERATION PROVIDERS (hosted demo: free-tier failover chain)
#
# Any subset you set is tried in order Groq -> Gemini -> OpenRouter, failing over
# when one is rate-limited or down. All are OpenAI-compatible. Model ids default
# to values current as of 2026-07 but free tiers churn — override if a call 404s.
# =============================================================================

# --- Groq (preferred; also where the safety check runs) ---
# Free key, no card: https://console.groq.com
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (via its OpenAI-compatible endpoint) ---
# Free key: https://aistudio.google.com
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (use a ":free" model id) ---
# Free key: https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# =============================================================================
# SAFETY CHECK (runs only when GROQ_API_KEY is set)
# =============================================================================
# A fast Groq model classifies the query ALLOW/BLOCK before generation. (Meta's
# Llama Guard was removed from Groq on 2026-03-05; set this to
# openai/gpt-oss-safeguard-20b for the purpose-built safeguard model instead.)
# GROQ_GUARD_MODEL=llama-3.1-8b-instant
# Reject (instead of allow) if the safety check itself errors. Default: fail-open.
# GROQ_GUARD_FAIL_CLOSED=false

# =============================================================================
# RATE LIMITING (Upstash Redis) — required for the caps to apply on Vercel
# =============================================================================
# Serverless workers are stateless, so counters live in Upstash (HTTP Redis).
# Create a free DB at https://console.upstash.com (or Vercel Marketplace).
# With these unset, rate limiting is skipped (fine for local dev).
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# --- Limits (defaults shown; override to retune without code changes) ---
# Per-IP: stops one visitor hammering the demo.
# RL_IP_HOUR=10
# RL_IP_DAY=50
# Global: circuit breaker across everyone; the real quota/wallet protector.
# RL_GLOBAL_HOUR=60
# RL_GLOBAL_DAY=300

# --- Guardrail ---
# Hard character cap on the query (mirrored client-side).
# MAX_QUERY_CHARS=500
# Extra comma-separated blocklist terms, merged with the built-in injection list.
# GUARDRAIL_BLOCKLIST=

# =============================================================================
# LOCAL-ONLY ALTERNATIVES (no hosted keys needed)
# =============================================================================
# With none of the above generation keys set, the app falls back to local Ollama.
#   ollama pull llama3.2 && ollama pull nomic-embed-text
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_GEN_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Claude override (local premium): used alone if set, ahead of the chain ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Hosted embeddings for semantic mode (optional; else browser-computed) ---
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small
# VOYAGE_API_KEY=pa-...
# VOYAGE_EMBED_MODEL=voyage-3.5-lite

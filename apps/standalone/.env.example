# Local-first: with NOTHING set, the app uses a local Ollama server.
# Install Ollama, then pull a generation and an embedding model:
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
#
# Keyword (BM25) retrieval works with no model and no key at all — only the
# semantic/hybrid modes and answer generation need a provider.

# --- local (defaults shown) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_GEN_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- generation override: Claude (checked first when set) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- generation + embedding override: OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_GEN_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- embedding override: Voyage (Anthropic's recommended embeddings) ---
# VOYAGE_API_KEY=pa-...
# VOYAGE_EMBED_MODEL=voyage-3.5-lite
